# ── Core ──────────────────────────────────────────────────────────────────────
INDEXIUM_VIDEO_DIR=test_videos        # Root directory of source video files
INDEXIUM_DB=video_faces.db            # SQLite database path
FRAME_SKIP=25                         # Frames to skip between face-detection samples
CPU_CORES=6                           # Worker processes (use "none" for all cores)
SAVE_CHUNK_SIZE=4                     # Batch size for DB face writes
SECRET_KEY=                           # Flask secret key (auto-generated if blank)
FLASK_DEBUG=false

# ── Face Detection & Clustering ───────────────────────────────────────────────
HDBSCAN_MIN_CLUSTER_SIZE=5            # Min faces to form a cluster (higher = fewer, cleaner groups)
FACE_DETECTION_MODEL=hog              # dlib backend: "hog" (fast) or "cnn" (accurate)
AUTO_CLASSIFY_THRESHOLD=0.3           # Confidence threshold for auto-tagging faces

# ── Manual Video Review ───────────────────────────────────────────────────────
MANUAL_VIDEO_REVIEW_ENABLED=true
NO_FACE_SAMPLE_COUNT=25               # Sample frames per manual-review video
NO_FACE_SAMPLE_DIR=thumbnails/no_faces
MANUAL_NAME_SUGGEST_THRESHOLD=0.82    # Fuzzy-match threshold for name suggestions
MANUAL_REVIEW_WARMUP_ENABLED=true
MANUAL_REVIEW_WARMUP_WORKERS=4        # Thread pool size for background warmup
MANUAL_REVIEW_WARMUP_DEPTH=10         # Upcoming videos to prewarm
MANUAL_KNOWN_PEOPLE_CACHE_SECONDS=30  # TTL for known-people name cache

# ── Metadata ──────────────────────────────────────────────────────────────────
METADATA_PLAN_WORKERS=8               # Parallel workers for metadata planning

# ── OCR ───────────────────────────────────────────────────────────────────────
INDEXIUM_OCR_ENABLED=true
INDEXIUM_OCR_ENGINE=auto              # "easyocr", "tesseract", or "auto"
INDEXIUM_OCR_LANGS=en                 # Comma-separated language codes
INDEXIUM_OCR_USE_GPU=false
INDEXIUM_OCR_FRAME_INTERVAL=60        # Frames between OCR samples
INDEXIUM_OCR_MIN_CONFIDENCE=0.5
INDEXIUM_OCR_MIN_TEXT_LENGTH=3
INDEXIUM_OCR_MAX_TEXT_LENGTH=80
INDEXIUM_OCR_MAX_RESULTS=200          # Max OCR entries per video
INDEXIUM_OCR_TOP_FRAGMENTS=10         # Top fragments to save per video

# ── NFO (Jellyfin) ────────────────────────────────────────────────────────────
NFO_REMOVE_STALE_ACTORS=true
NFO_BACKUP_MAX_AGE_DAYS=30
